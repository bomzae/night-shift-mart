extends "res://tests/prompt11_1_smoke.gd"

func aim(point: Vector3) -> void:
	interaction.camera.look_at(point)
	await frames(3)

func run_checks() -> void:
	await setup_mart()
	player.position = Vector3(0,0.01,14)
	var item: GrabbableBody = load(ProductCatalog.find(&"bread").scene_path).instantiate()
	mart.add_child(item)
	await place(item, player.position + Vector3(0,1.2,-1.5))
	item.freeze = true
	await aim(item.global_position)
	check(interaction.context_prompt.text == "[LMB] GRAB" and interaction.product_info.text.contains("HP"), "crosshair bread shows product details and Grab action")
	check(not interaction.context_prompt.get_global_rect().intersects(interaction.product_info.get_global_rect()), "product detail and action rectangles are separate")
	item.queue_free()
	await frames(3)
	check(not interaction.context_prompt.visible and not interaction.product_info.visible, "destroyed target clears context and details")
	await aim(player.position + Vector3(0,6,-4))
	check(not interaction.context_prompt.visible, "targetless empty hand hides prompt")
	player.health.current_health = 60
	var food := held_food(&"milk")
	await frames(3)
	check(interaction.context_prompt.text == "[F] EAT\n[RMB] THROW" and interaction.product_info.text.contains("HP"), "held food displays contextual F Eat, Throw and heal value")
	await press("use_tool")
	check(player.health.current_health == 80 and not is_instance_valid(food), "F consumes actual milk and self heals once")
	food = held_food(&"bread")
	var dummy := dummy_at(player.position + Vector3(0,0,-1.5))
	dummy.health.enter_downed()
	await aim(dummy.position + Vector3.UP * 0.7)
	check(interaction.context_prompt.text.contains("[E] FEED") and interaction.context_prompt.text.split("\n").size() <= 2, "downed teammate food prompt prioritizes Feed with at most two actions")
	await press("interact")
	check(not dummy.health.is_downed and dummy.health.current_health == 30 and player.health.current_health == 80, "E feeds teammate without self eating or duplicate interaction")
	food = held_food(&"bread")
	dummy.health.enter_downed()
	await aim(dummy.position + Vector3.UP * 0.7)
	await press("use_tool")
	check(dummy.health.is_downed and player.health.current_health == 95, "F remains self heal even while aiming at downed teammate")
	dummy.queue_free()
	await frames(2)
	food = held_food(&"milk")
	await press("consume_item")
	check(player.health.current_health == 100 and not is_instance_valid(food), "legacy G compatibility still consumes food")
	food = held_food(&"bread")
	await frames(3)
	check(not interaction.context_prompt.text.contains("EAT"), "full HP does not advertise an unavailable heal")
	await press("use_tool")
	check(is_instance_valid(food), "full HP F cannot waste food")
	interaction.drop_held()
	food.queue_free()
	var extinguisher: FireExtinguisher = load("res://scenes/interactables/fire_extinguisher.tscn").instantiate()
	mart.add_child(extinguisher)
	extinguisher.position = player.position + Vector3.UP
	extinguisher.begin_carry(interaction, player)
	interaction.held_object = extinguisher
	await frames(3)
	check(interaction.context_prompt.text == "[F] SPRAY", "held extinguisher displays F Spray")
	var capacity := extinguisher.capacity
	Input.action_press("use_tool")
	await frames(10)
	Input.action_release("use_tool")
	check(extinguisher.capacity < capacity, "F tool spray remains continuous")
	interaction.drop_held()
	extinguisher.queue_free()
	var crate := WeaponCrate.new()
	crate.weapon = preload("res://data/weapons/bat.tres")
	mart.add_child(crate)
	crate.position = player.position + Vector3(0,0.3,-1.6)
	await aim(crate.position)
	check(interaction.context_prompt.text == "[E] OPEN CRATE", "aimed crate displays E Open")
	await press("interact")
	check(not is_instance_valid(crate), "E still opens physical weapon crate")
	var weapon: WeaponBody
	for body in mart.get_children():
		if body is WeaponBody: weapon = body
	check(weapon != null and weapon.begin_carry(interaction, player), "opened weapon remains physically grabbable")
	interaction.held_object = weapon
	await aim(player.position + Vector3(0,1.5,-5))
	check(interaction.context_prompt.text == "[LMB] SWING", "held weapon advertises LMB Swing")
	await press("grab")
	check(weapon.swinging(), "LMB still starts real weapon swing")
	await frames(90)
	await press("throw")
	check(interaction.held_object == null and weapon.linear_velocity.length() > 1, "RMB charged physical throw unchanged")
	# Actual checkout availability and actual execution use the same action resolver.
	await setup_mart()
	await stock("can")
	var customer := manager.spawn_customer([&"can"])
	await wait_checkout(customer)
	await aim(station.get_node("Scanner").global_position)
	check(interaction.context_prompt.text.contains("[E] SCAN"), "checkout Scanner displays E Scan")
	var echo := InputEventKey.new()
	echo.physical_keycode = KEY_E
	echo.pressed = true
	echo.echo = true
	interaction._unhandled_input(echo)
	await frames(2)
	check(customer.scanned == 0, "E keyboard repeat does not auto scan")
	await press("interact")
	await frames(35)
	await aim(station.get_node("Payment").global_position)
	check(interaction.context_prompt.text.contains("[E] PAY"), "checkout Payment displays E Pay after scan")
	await press("interact")
	check(customer.resolved and manager.sales > 0, "context E pays once through existing checkout")
	check(not interaction.context_prompt.text.contains("PAY"), "completed customer removes stale Pay prompt")
	player.health.current_health = 80
	held_food(&"bread")
	DayManager.notify_event(mart, &"family")
	await frames(3)
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://.godot/p131_context.png")
	print("Prompt 13.1 context completed; failures: ", failures)
	quit(1 if failures else 0)
