extends "res://tests/prompt8_smoke.gd"

func run_checks() -> void:
	await fire_setup()
	check(InputMap.has_action("toggle_customer_spawn"), "U action exists")
	var defaults := CustomerManager.new()
	check(defaults.spawning_enabled and defaults.spawn_interval_min == 6 and defaults.spawn_interval_max == 10, "normal spawn defaults unchanged")
	defaults.free()
	manager.spawning_enabled = true
	await press("toggle_customer_spawn")
	check(not manager.spawning_enabled and manager._spawn_label.text.ends_with("OFF"), "U disables auto spawn with visible status")
	manager._timer = 0.01
	await frames(30)
	check(manager.customers.is_empty(), "OFF prevents automatic customers")
	await stock("can")
	await press("debug_spawn_dangerous")
	check(manager.customers.size() == 1 and manager.customers[0] is DangerousCustomer, "manual P remains available while OFF")
	var existing := manager.customers[0]
	var previous := existing.global_position
	await frames(25)
	check(existing.global_position.distance_to(previous) > 0.1, "existing customer continues while OFF")
	existing.global_position = Vector3(-6, 0, 8)
	await press("debug_spawn_drunk")
	await press("debug_spawn_lost_child")
	check(mart.get_node("Drunks").get_children().any(func(n): return n is DrunkCustomer) and mart.get_node("LostFamilies").pairs.size() == 1, "K and L remain available while OFF")
	await press("debug_spawn_accident")
	check(manager.customers.any(func(c): return c is AccidentCustomer), "manual O remains available while OFF")
	for c in manager.customers: c.global_position = Vector3(-5, 0, 7 + manager.customers.find(c))
	var count := manager.customers.size()
	await press("toggle_customer_spawn")
	await frames(3)
	check(manager.spawning_enabled and manager.customers.size() > count, "ON resumes automatic generation")

	await fire_setup()
	player.set_physics_process(true)
	player.global_position = Vector3(0, 0.01, -1)
	await frames(3)
	var fire := fire_manager.create_fire(player.global_position, [player.get_rid()])
	fire_manager.minimum_fire_spacing = 0.2
	var overlap := fire_manager.create_fire(player.global_position + Vector3(0.4, 0, 0), [player.get_rid()])
	await frames(5)
	check(player.fire_reaction.active() and player.fire_reaction.feedback.visible, "player contact begins visible reaction")
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://.godot/p81_player_feedback.png")
	check(not player.knockdown.active(), "fire does not cause knockdown")
	var before_look: float = player.rotation.y
	var look := InputEventMouseMotion.new()
	look.relative = Vector2(12, 0)
	Input.parse_input_event(look)
	await frames(3)
	check(not is_equal_approx(before_look, player.rotation.y), "look remains available during fire reaction")
	check(player.velocity.x > 0.1, "player moves away from flame")
	check(not player.fire_reaction.begin(fire.global_position), "active reaction cannot stack")
	check(player.fire_reaction.reaction_count == 1, "overlapping fires trigger only one reaction")
	fire.suppress(2)
	overlap.suppress(2)
	await frames(22)
	check(not player.fire_reaction.active() and not player.fire_reaction.feedback.visible, "player feedback ends after short disruption")
	check(not player.fire_reaction.begin(player.global_position), "cooldown prevents immediate repeat")
	await frames(50)
	check(player.fire_reaction.begin(player.global_position), "reaction available after cooldown")
	Input.action_press("move_forward")
	await frames(6)
	check(player.velocity.z < -0.1, "movement input still acts during reaction")
	Input.action_release("move_forward")
	player.knockdown.try_start(Vector3.FORWARD)
	await frames(2)
	check(not player.fire_reaction.active() and not player.fire_reaction.feedback.visible, "knockdown takes priority over fire feedback")
	check(not player.fire_reaction.begin(player.global_position), "down player cannot retrigger panic")

	for scene in ["basic_customer", "accident_customer", "dangerous_customer"]:
		await fire_setup()
		await stock("can")
		var npc := manager.spawn_customer([&"can"], load("res://scenes/interactables/" + scene + ".tscn"))
		npc.global_position = Vector3(0, 0.01, -1)
		npc.waypoints = [Vector3(0, 0.01, 1)]
		var route := npc.waypoints.duplicate()
		fire = fire_manager.create_fire(npc.global_position, [npc.get_rid()])
		await frames(10)
		check(npc.fire_reaction.active() and npc.fire_reaction.sign.visible, scene + " visible panic")
		check(npc.state == BasicCustomer.State.STORE and npc.waypoints == route and npc.goods.size() == 1, scene + " preserves route and reservation")
		var retreat := npc.global_position - fire.global_position
		print("RETREAT ", scene, " offset=", retreat, " direction=", npc.fire_reaction.direction)
		check(retreat.dot(npc.fire_reaction.direction) > 0.05, scene + " retreats from fire")
		fire.suppress(2)
		await frames(45)
		check(not npc.fire_reaction.active() and npc.velocity.z > 0, scene + " resumes shopping movement")

	await fire_setup()
	player.global_position = Vector3(5, 0.01, 11.25)
	await stock("can")
	var queued := manager.spawn_customer([&"can"])
	await wait_checkout(queued)
	check(queued.picked_items.size() == 1, "prepare actual basket for queue reaction")
	fire = fire_manager.create_fire(queued.global_position, [queued.get_rid()])
	await frames(5)
	var patience_before := queued.patience_left
	await frames(10)
	check(queued.fire_reaction.active() and queued.state == BasicCustomer.State.CHECKOUT and queued.patience_left == patience_before, "queue state and patience pause during panic")
	check(manager.queue.has(queued) and queued.picked_items.size() == 1 and not station.use_station("scan"), "panic keeps basket and queue but pauses scanning")
	fire.suppress(2)
	await frames(120)
	check(station.use_station("scan"), "scan works after panic recovery")
	await frames(32)
	check(station.use_station("pay") and manager.sales == 5, "recovered customer pays same basket")

	await fire_setup()
	var drunk: DrunkCustomer = mart.get_node("Drunks").spawn_drunk()
	await place(drunk, Vector3(0, 0.9, -1))
	await frames(5)
	check(drunk.fire_reaction.begin(drunk.global_position), "drunk accepts fire reaction")
	var wander := drunk.wander_direction
	await frames(15)
	check(drunk.wander_direction == wander and drunk.fire_reaction.sign.visible, "drunk wander paused with panic")
	await frames(40)
	check(not drunk.fire_reaction.active() and drunk.linear_velocity.length() > 0.1, "drunk resumes movement")

	await fire_setup()
	var families = mart.get_node("LostFamilies")
	var child: LostChild = families.spawn_pair()
	check(child.fire_reaction.begin(child.global_position), "lost child reacts without event failure")
	check(child.begin_carry(interaction, player), "child can still be carried during reaction")
	await frames(2)
	check(not child.fire_reaction.active(), "carried child cancels own fire reaction")
	child.end_carry()
	await place(child, child.parent_npc.global_position + Vector3(0.7, 0.6, 0))
	check(families.try_reunion(child), "correct reunion remains possible")
	await frames(65)
	var parent: LostParent = child.parent_npc
	check(parent.fire_reaction.begin(parent.global_position) and child.fire_reaction.begin(child.global_position), "departing family can react")
	var parent_route := parent.waypoints.duplicate()
	await frames(10)
	check(parent.waypoints == parent_route and parent.reunited and child.reunited, "family event and exit path preserved")
	check(parent.get_collision_exceptions().has(child) and child.get_collision_exceptions().has(parent), "family collision exceptions preserved")
	await frames(45)
	check(not parent.fire_reaction.active() and not child.fire_reaction.active(), "family resumes after panic")
	for tick in range(1400):
		await frames(1)
		if not is_instance_valid(parent): break
	check(not is_instance_valid(parent) and not is_instance_valid(child), "reunited family completes exit after panic")

	await fire_setup()
	var product := await make_product(Vector3(0, 0.25, -1))
	fire_manager.burn_exposure = 1.8
	fire = fire_manager.create_fire(Vector3(0, 0.01, -1), [product.get_rid()])
	fire.intensity = 1
	await frames(40)
	check(product.has_node("BurnFeedback") and product.get_node("BurnFeedback").visible, "burning product has visible progress")
	interaction.camera.global_position = Vector3(2, 2, 2.5)
	interaction.camera.look_at(product.global_position + Vector3.UP)
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://.godot/p81_burn_feedback.png")
	check(fire_manager.fire_damage_value == 0, "exposure alone does not bill loss")
	fire.suppress(2)
	await frames(35)
	check(not product.get_node("BurnFeedback").visible and is_instance_valid(product), "extinguished product stops burn feedback and survives")
	fire = fire_manager.create_fire(Vector3(0, 0.01, -1), [product.get_rid()])
	fire.intensity = 1
	await frames(100)
	check(not is_instance_valid(product) and fire_manager.fire_damage_value == 5, "threshold destroys product and records exact loss")
	check(fire_manager._label.text.contains("FIRE LOSS: $5"), "explicit fire loss label")
	await frames(70)
	check(fire_manager.fire_damage_value == 5, "loss cannot repeat after destruction")
	print("Prompt 8.1 smoke checks completed; failures: ", failures)
	quit(0 if failures == 0 else 1)
