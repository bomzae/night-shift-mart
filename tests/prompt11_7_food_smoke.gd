extends "res://tests/prompt11_smoke.gd"

func run_checks() -> void:
	await boss_setup()
	rat.set_physics_process(false)
	rat.position = Vector3(26, 0.01, 27)
	player.position = Vector3(26, 0.01, 34)
	var foods: Array[GrabbableBody] = []
	for i in range(2):
		var item: GrabbableBody = load(ProductCatalog.find(&"bread").scene_path).instantiate()
		mart.add_child(item)
		item.position = rat.position + Vector3(1 + i, 0.3, 0)
		foods.append(item)
	await frames(2)
	rat.current_zone = rat.nearest_zone(rat.position)
	rat.seek_food()
	check(rat.food == foods[0] and not rat.is_aggro, "neutral boss selects nearest real food")
	foods[0].begin_carry(interaction, player)
	check(not rat.valid_food(foods[0]), "player grab invalidates food target")
	rat.seek_food()
	check(rat.food == foods[1] and not rat.is_aggro, "taking food only retargets another product")
	foods[0].end_carry()
	rat.receive_damage(1, null, player)
	var location := rat.position
	rat.clear_aggro()
	rat.seek_food()
	check(rat.position == location and rat.current_zone == rat.nearest_zone(location) and rat.food != null, "disengage searches locally without center reset")
	var wall := Graybox.box(mart, "ThreatWall", Vector3(5, 2, 0.2), rat.position + Vector3(0, 1, 1), Color.GRAY)
	player.position = rat.position + Vector3.BACK * 2
	await frames(2)
	for i in range(120): rat.update_awareness(1.0 / 60)
	check(not rat.is_aggro, "wall-separated close player is not harassment")
	wall.queue_free()
	await frames(2)
	rat.receive_damage(1, null, player)
	var last_known := rat.last_known_position
	wall = Graybox.box(mart, "MemoryWall", Vector3(5, 2, 0.2), rat.position + Vector3(0, 1, 1), Color.GRAY)
	await frames(2)
	rat.update_awareness(3)
	check(rat.is_aggro and rat.last_known_position == last_known and rat.target_memory > 8, "aggro retains memory behind shelf")
	rat.receive_damage(1)
	check(rat.target_memory < 10, "environment damage does not refresh player memory")
	rat.receive_damage(1, null, player)
	check(rat.target_memory == rat.aggro_memory_time, "attributed damage refreshes memory without LOS")
	wall.queue_free()
	rat.clear_aggro()
	player.position = Vector3(26, 0.01, 34)
	var stale: GrabbableBody = load(ProductCatalog.find(&"can").scene_path).instantiate()
	mart.add_child(stale)
	stale.begin_carry(interaction, player)
	stale.end_carry()
	stale.attack_attribution.expires_frame = Engine.get_physics_frames()
	stale.position = rat.position + Vector3(0, 0.85, 3)
	stale.gravity_scale = 0
	stale.launch(Vector3.FORWARD, 12, 4)
	var hits := rat.hit_count
	await frames(40)
	check(rat.hit_count > hits and not rat.is_aggro, "actual expired-owner projectile damages without aggro")
	var cart: ShoppingCart = mart.get_node("Cart")
	cart.update_control(player, interaction.camera)
	check(cart.attack_attribution.current() == player, "current cart driver attribution refreshes")
	cart.attack_attribution.expires_frame = Engine.get_physics_frames()
	check(cart.attack_attribution.current() == null, "abandoned cart attribution expires")
	quit(0 if failures == 0 else 1)
