extends "res://tests/prompt4_smoke.gd"

func crouch(value: bool) -> void:
	if value: Input.action_press("crouch")
	else: Input.action_release("crouch")
	player.update_stance()
	await frames(2)

func run_checks() -> void:
	await setup_mart()
	player.position = Vector3(0,0.01,20)
	var binding: InputEventKey = InputMap.action_get_events("crouch")[0]
	check(binding.physical_keycode == KEY_CTRL and binding.location == KEY_LOCATION_LEFT,"Left Ctrl hold binding")
	await crouch(true)
	check(player.crouched and is_equal_approx(player.head.position.y,0.58),"crouch lowers camera to 0.58m")
	check(is_equal_approx(player.get_node("CollisionShape3D").shape.height,0.85),"real capsule lowers to 0.85m")
	player.set_physics_process(true)
	Input.action_press("move_forward")
	await frames(30)
	check(absf(player.velocity.z) > 2.5 and absf(player.velocity.z) < 3.4,"crouch moves at 65 percent speed")
	Input.action_release("move_forward")
	await frames(20)
	player.set_physics_process(false)
	await crouch(false)
	check(not player.crouched and is_equal_approx(player.head.position.y,1.6),"release stands in clear space")
	await crouch(true)
	var ceiling := StaticBody3D.new()
	var collider := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(2,0.2,2)
	collider.shape = shape
	ceiling.add_child(collider)
	mart.add_child(ceiling)
	ceiling.position = player.position+Vector3(0,1.1,0)
	await frames(3)
	await crouch(false)
	check(player.crouched and not player.can_stand(),"blocked ceiling retains crouch without expanding capsule")
	ceiling.queue_free()
	await frames(3)
	player.update_stance()
	check(not player.crouched,"stands after overhead obstruction is removed")
	var shelf: StockShelf = mart.get_node("Shelves/CanShelf")
	var data := ProductCatalog.find(&"instant_noodles")
	var body: GrabbableBody = load(data.scene_path).instantiate()
	mart.get_node("Products").add_child(body)
	await place(body,shelf.to_global(Vector3(0,0.12,-0.15)))
	player.position = shelf.to_global(Vector3(0,0.01,1.45))
	interaction.camera.look_at(body.global_position)
	check(interaction.find_candidate() != body,"standing view is blocked by actual lower shelf deck")
	await crouch(true)
	interaction.camera.look_at(body.global_position)
	check(interaction.find_candidate() == body,"crouched ray reaches product under actual shelf")
	interaction.toggle_grab()
	check(interaction.held_object == body,"crouched player grabs low product")
	interaction.camera.look_at(shelf.to_global(Vector3(0,0.35,3)))
	await frames(90)
	check(shelf.to_local(body.global_position).z > 0.7,"carry spring physically extracts product from under shelf")
	await crouch(false)
	var noodles: StockShelf = mart.get_node("Shelves/InstantNoodlesShelf")
	player.position = noodles.to_global(Vector3(-0.9,0.01,1.6))
	interaction.camera.look_at(noodles.to_global(Vector3(-0.9,1.3,0.2)))
	var last_position := body.global_position
	var largest_step := 0.0
	for tick in range(120):
		await frames(1)
		largest_step = maxf(largest_step,body.global_position.distance_to(last_position))
		last_position = body.global_position
	check(largest_step < 0.2,"restocking remains continuous physical carry, never position snap")
	print("LOW RESTOCK held=",interaction.held_object," local=",noodles.to_local(body.global_position)," rotation=",body.rotation," blocked=",interaction.hold_obstructed," shelf=",interaction.placement_shelf)
	interaction.drop_held(true)
	await frames(120)
	check(noodles.has_stock(body),"recovered floor product can be physically restocked")
	interaction.camera.look_at(body.global_position)
	interaction.toggle_grab()
	interaction.camera.look_at(noodles.to_global(Vector3(-0.9,1.5,4)))
	await frames(90)
	await crouch(true)
	await press("throw")
	check(interaction.held_object == null and body.linear_velocity.length() > 1,"crouched charged throw remains functional")
	var cart: ShoppingCart = mart.get_node("Cart")
	await place(cart,Vector3(0,0.02,20))
	await place(body,Vector3(0,0.11,20))
	player.position = Vector3(0,0.01,22.65)
	interaction.camera.look_at(body.global_position)
	check(interaction.find_candidate() == body,"low ray reaches product below cart floor")
	interaction.toggle_grab()
	check(interaction.held_object == body,"product below cart can be grabbed")
	interaction.camera.look_at(Vector3(0,0.35,25))
	await frames(90)
	check(body.global_position.z > cart.global_position.z+1.0,"carry extracts product from under cart")
	interaction.drop_held(true)
	player.position = Vector3(0,0.01,24)
	player.set_physics_process(true)
	check(player.knockdown.try_start(Vector3.FORWARD),"knockdown starts while crouched")
	await crouch(false)
	await frames(10)
	check(player.knockdown.active() and player.crouched,"knockdown owns camera and stance until recovery")
	await frames(100)
	check(not player.knockdown.active() and not player.crouched,"normal safe stance restored after knockdown")
	quit(1 if failures else 0)
