extends "res://tests/prompt11_smoke.gd"

func run_checks() -> void:
	await boss_setup()
	var cart: ShoppingCart = mart.get_node("Cart")
	await place(cart,Vector3(0,0.02,20))
	rat.position = Vector3(0,0.01,14)
	player.position = Vector3(0,0.43,20)
	rat.set_physics_process(false)
	rat.provoke(player)
	await frames(5)
	rat.pursuit_planner.refresh_exclusions()
	check(rat.cart_supports(cart,player),"support ray identifies actual cart deck")
	check(rat.clear_combat_lane(player.position),"solid target cart can be charged")
	check(not rat.pursuit_planner.clear_segment(rat.position,player.position),"walkable path still rejects cart interior")
	var wall := StaticBody3D.new()
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(4,3,0.3)
	shape.shape = box
	wall.add_child(shape)
	mart.add_child(wall)
	wall.position = Vector3(0,1.5,17)
	await frames(3)
	check(not rat.clear_combat_lane(player.position),"world wall before cart is not ignored")
	wall.queue_free()
	await frames(3)
	var other: ShoppingCart = load("res://scenes/interactables/shopping_cart.tscn").instantiate()
	mart.add_child(other)
	await place(other,Vector3(0,0.02,17))
	await frames(5)
	check(not rat.clear_combat_lane(player.position),"second blocking cart remains path obstacle")
	other.queue_free()
	await frames(3)
	player.position = Vector3(0,0.01,22)
	check(not rat.cart_supports(cart,player) and not rat.clear_combat_lane(player.position),"floor player behind cart does not bypass obstruction")
	player.position = Vector3(0,2.5,20)
	check(not rat.cart_supports(cart,player),"floating target is not a cart rider")
	player.position = Vector3(0,0.43,20)
	player.health.max_health = 10000
	player.health.current_health = 10000
	player.set_physics_process(true)
	cart.apply_central_impulse(Vector3(6,0,0))
	rat._charge_wait = 0
	rat.set_physics_process(true)
	await frames(600)
	check(rat.aggro_target == player and rat.charge_count > 0,"moving cart retains target and attack progression")
	check(player.health.current_health < 10000,"moving cart combat causes real damage")
	quit(1 if failures else 0)